#!/usr/bin/env python3
"""Ancien nom. Toute la CLI est local-scout."""

import os
import sys
from pathlib import Path

print("local-agent : la CLI s'appelle local-scout. Transfert.", file=sys.stderr)
target = Path(__file__).resolve().parent / "local-scout"
os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])
