#!/usr/bin/env python3
"""Former name. The whole CLI is now local-scout."""

import os
import sys
from pathlib import Path

print("local-agent: the CLI is now called local-scout. Forwarding.", file=sys.stderr)
target = Path(__file__).resolve().parent / "local-scout"
os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])
