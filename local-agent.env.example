# Local overrides for local-scout (variable names keep the historical local-agent prefix).
# Copy to local-agent.env (ignored by git) for a personal setting.
# Variables already set in the environment take precedence over this file.

# Local OpenAI-compatible server: mlx-serve, Ollama, llama.cpp, LM Studio, vLLM…
# The former MLX_* names are still read for backward compatibility.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11234/v1
# auto = first model loaded on the server
LOCAL_LLM_MODEL=auto
LOCAL_LLM_PROVIDER=mlx
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_TIMEOUT=300
LOCAL_LLM_MAX_TOKENS=1600
# 0 = read context_length from the server
LOCAL_LLM_MAX_CONTEXT=0
# Only set this if the server requires a Bearer token
LOCAL_LLM_API_KEY=

# Context and output bounds
LOCAL_AGENT_MAX_FILES=40
LOCAL_AGENT_MAX_FILE_SIZE=120000
LOCAL_AGENT_MAX_OUTPUT_TOKENS=900
LOCAL_AGENT_CHUNK_CHARS=12000
LOCAL_AGENT_MAX_CHUNKS=8
LOCAL_AGENT_MAX_MATCHES=200
LOCAL_AGENT_FIX_MAX_FILE_SIZE=40000
LOCAL_AGENT_COMMAND_TIMEOUT=900
LOCAL_AGENT_COMPOUND_TURNS=25
LOCAL_AGENT_VISION=1
LOCAL_AGENT_ENABLE_VISION=1
LOCAL_AGENT_ENABLE_OCR=1
LOCAL_AGENT_ENABLE_CACHE=1

# local_task loop
LOCAL_AGENT_MAX_STEPS=12
LOCAL_AGENT_MAX_TOOL_CALLS=24
LOCAL_AGENT_MAX_RUNTIME=180
LOCAL_AGENT_OUTPUT_BUDGET=1500
LOCAL_AGENT_LOCAL_CONTEXT_BUDGET=48000
LOCAL_AGENT_AUTONOMY=read_only
LOCAL_AGENT_MAX_RETRIES=2

# Optional Jira / Confluence, never committed. Prefer the target repository's .claude/.env.local
# (JIRA_URL, JIRA_USERNAME, JIRA_API_TOKEN: the format project skills already use).
# JIRA_BASE_URL=
# JIRA_TOKEN=
# JIRA_EMAIL=
# CONFLUENCE_BASE_URL=
# CONFLUENCE_TOKEN=
